{
  "name": "remotish-github-provider",
  "displayName": "Remotish GitHub Provider",
  "description": "Anonymous read-only GitHub.com public repository provider for Remotish.",
  "version": "1.0.0-rc.1",
  "publisher": "hrashton",
  "license": "0BSD",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Codellei/remotish.git"
  },
  "homepage": "https://github.com/Codellei/remotish/tree/master/extensions/github-provider#readme",
  "bugs": {
    "url": "https://github.com/Codellei/remotish/issues"
  },
  "engines": {
    "vscode": "^1.139.1"
  },
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:remotish-github",
    "onCommand:remotish.github.open"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "remotish": {
    "provider": true,
    "apiVersion": 1,
    "id": "github",
    "displayName": "GitHub"
  },
  "dependencies": {
    "@remotish/adapter-github": "workspace:*",
    "@remotish/adapter-sdk": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "github",
    "remote repositories",
    "virtual filesystem",
    "source control",
    "open vsx"
  ],
  "contributes": {
    "commands": [
      {
        "command": "remotish.github.open",
        "title": "Remotish GitHub: Open Repository"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "[Open GitHub Repository](command:remotish.github.open)"
      }
    ]
  }
}
